<Window x:Class="WaferSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaferSimulator.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="C++ DLL 연동 테스트" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBox x:Name="InputA" Width="70" Height="28" Text="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14"/>
                <TextBlock Text="+" VerticalAlignment="Center" Margin="10,0" FontSize="16" FontWeight="Bold"/>
                <TextBox x:Name="InputB" Width="70" Height="28" Text="20" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14"/>
            </StackPanel>

            <Button x:Name="BtnCalculate" Content="C++ 함수 호출" Width="160" Height="35" Margin="0,0,0,20" Click="BtnCalculate_Click" Cursor="Hand"/>

            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="15" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock x:Name="TxtSumResult" Text="연산 결과: 버튼을 눌러주세요." FontSize="13" Margin="0,0,0,8" Foreground="#333333"/>
                    <TextBlock x:Name="TxtStatusResult" Text="엔진 상태 코드: -" FontSize="13" Foreground="#666666"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
