<Window x:Class="WaferSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WaferSimulator.UI.ViewModels"
        Title="Wafer Vision Simulator"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="620"
        Background="#101418">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#182026" />
            <Setter Property="BorderBrush" Value="#2A343D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE6ED" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#95A6B3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Wafer Vision Simulator"
                           Foreground="#F2F6F8"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="C# WPF MVVM dashboard / C++ OpenCV inspection core"
                           Foreground="#8796A2"
                           FontSize="13"
                           Margin="0,5,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="#102A1F"
                    BorderBrush="#2C7A4B"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#7EE0A1"
                           FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Text="Control Panel" Style="{StaticResource PanelTitle}" />
                    <Button Command="{Binding StartInspectionCommand}"
                            Height="44"
                            Background="#1F7A4D"
                            BorderBrush="#3DA86E"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Content="Start Inspection" />

                    <Separator Margin="0,18" Background="#2A343D" />

                    <TextBlock Text="Recipe" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="Input: 500 x 500 Gray8" Style="{StaticResource MetricText}" />
                    <TextBlock Text="Preprocess: Gaussian blur" Style="{StaticResource MetricText}" />
                    <TextBlock Text="Detect: Threshold + labeling" Style="{StaticResource MetricText}" />
                    <TextBlock Text="ROI Count: Integral point map" Style="{StaticResource MetricText}" />

                    <Separator Margin="0,18" Background="#2A343D" />

                    <TextBlock Text="Result" Style="{StaticResource PanelTitle}" />
                    <TextBlock Text="{Binding ResultText}"
                               Foreground="#DDE6ED"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="20" />
                    <TextBlock Text="{Binding RoiText}"
                               Foreground="#F5C76B"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Live Wafer Map" Style="{StaticResource PanelTitle}" />
                    <Viewbox Grid.Row="1" Stretch="Uniform">
                        <Canvas Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                Background="#030506">
                            <Image Source="{Binding WaferImage}"
                                   Width="{Binding CanvasWidth}"
                                   Height="{Binding CanvasHeight}"
                                   Stretch="Fill" />
                            <Rectangle Canvas.Left="{Binding RoiX}"
                                       Canvas.Top="{Binding RoiY}"
                                       Width="{Binding RoiWidth}"
                                       Height="{Binding RoiHeight}"
                                       Stroke="#F5C76B"
                                       StrokeThickness="2"
                                       StrokeDashArray="7 5"
                                       Fill="#22F5C76B" />
                            <ItemsControl ItemsSource="{Binding FaultList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding MarkerLeft}" />
                                        <Setter Property="Canvas.Top" Value="{Binding MarkerTop}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="36" Height="20">
                                            <Ellipse Width="10"
                                                     Height="10"
                                                     Fill="#FF4B4B"
                                                     Stroke="#FFFFFF"
                                                     StrokeThickness="1"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Index}"
                                                       Foreground="#FFFFFF"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Margin="13,-2,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Defect Coordinates" Style="{StaticResource PanelTitle}" />
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding FaultList}"
                              Background="#12191E"
                              BorderBrush="#2A343D"
                              Foreground="#DDE6ED">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" DisplayMemberBinding="{Binding Index}" Width="42" />
                                <GridViewColumn Header="X" DisplayMemberBinding="{Binding X}" Width="84" />
                                <GridViewColumn Header="Y" DisplayMemberBinding="{Binding Y}" Width="84" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
