<Window x:Class="WaferSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WaferSimulator.UI.ViewModels"
        mc:Ignorable="d"
        Title="Wafer Vision Simulator" Height="760" Width="1180"
        MinHeight="660" MinWidth="980"
        Background="#F4F6F8">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Wafer Vision Simulator" FontSize="22" FontWeight="Bold" Foreground="#1F2933"/>
                <TextBlock Text="{Binding ImageSpecText}" FontSize="12" Foreground="#697386" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SelectedAlgorithmText}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right"
                    Background="#102A1F"
                    BorderBrush="#2C7A4B"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#7EE0A1"
                           FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="이미지 로드" Width="120" Height="36" Margin="0,0,8,0"
                        Command="{Binding LoadImageCommand}" Cursor="Hand"/>
                <Button Content="자동 탐지" Width="120" Height="36" Margin="0,0,8,0"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold"
                        Command="{Binding StartInspectionCommand}" Cursor="Hand"/>
                <Button Content="{Binding MonitoringButtonText}" Width="160" Height="36"
                        Background="#111827" Foreground="White" FontWeight="SemiBold"
                        Command="{Binding ToggleMonitoringCommand}" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#D7DEE8" BorderThickness="1" Background="#FFFFFF" Padding="10" Margin="0,0,0,14">
            <WrapPanel>
                <TextBlock Text="OpenCV / 알고리즘 구현" FontSize="13" FontWeight="SemiBold" Foreground="#1F2933"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="침식" Width="92" Height="32" Margin="0,0,8,8"
                        Command="{Binding AlgorithmCommand}" CommandParameter="Erosion"/>
                <Button Content="팽창" Width="92" Height="32" Margin="0,0,8,8"
                        Command="{Binding AlgorithmCommand}" CommandParameter="Dilation"/>
                <Button Content="히스토그램" Width="102" Height="32" Margin="0,0,8,8"
                        Command="{Binding AlgorithmCommand}" CommandParameter="Histogram"/>
                <Button Content="가우시안" Width="102" Height="32" Margin="0,0,8,8"
                        Command="{Binding AlgorithmCommand}" CommandParameter="Gaussian"/>
                <Button Content="라플라시안" Width="102" Height="32" Margin="0,0,8,8"
                        Command="{Binding AlgorithmCommand}" CommandParameter="Laplacian"/>
                <Button Content="이진화" Width="92" Height="32" Margin="0,0,8,8"
                        Command="{Binding AlgorithmCommand}" CommandParameter="Threshold"/>
                <Button Content="템플릿매칭" Width="116" Height="32" Margin="0,0,8,8"
                        Command="{Binding AlgorithmCommand}" CommandParameter="TemplateMatching"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D7DEE8" BorderThickness="1" Background="#FFFFFF" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="원본 이미지" FontSize="14" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Background="#0B1020">
                        <Image Source="{Binding InputImage}" Stretch="Uniform" SnapsToDevicePixels="True"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D7DEE8" BorderThickness="1" Background="#FFFFFF" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="처리 결과" FontSize="14" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,10"/>
                    <Border Grid.Row="1" Background="#0B1020">
                        <Image Source="{Binding ProcessedImage}" Stretch="Uniform" SnapsToDevicePixels="True"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D7DEE8" BorderThickness="1" Background="#FFFFFF" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding ResultText}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FaultList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="13" Foreground="#374151" Margin="2,2,0,2">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="[결함 {0}] 좌표: ({1}, {2})">
                                                <Binding Path="Index"/>
                                                <Binding Path="X"/>
                                                <Binding Path="Y"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#D7DEE8" BorderThickness="1" Background="#FFFFFF" Padding="12">
                <StackPanel>
                    <TextBlock Text="엔진 상태" FontSize="14" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#4B5563" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
