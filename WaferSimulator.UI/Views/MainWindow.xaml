<Window x:Class="WaferSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaferSimulator.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="C++ DLL 연동 테스트" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <StackPanel VerticalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="가상 웨이퍼 입력 스펙: 500 x 500 (8-bit Gray)" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                <Button x:Name="BtnCalculate" Content="OpenCV 비전 엔진 가동" Width="200" Height="40" Margin="0,0,0,25" 
                    Background="#2E7D32" Foreground="White" FontWeight="Bold" FontSize="14"
                    Click="BtnCalculate_Click" Cursor="Hand"/>
            </StackPanel>

            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="15" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock x:Name="TxtSumResult" Text="[검사 결과] 버튼을 누르면 OpenCV 레이블링 연산이 시작됩니다." FontSize="13" Margin="0,0,0,12" Foreground="#34495E" LineHeight="20"/>
                    <Separator Background="#ECF0F1" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtStatusResult" Text="엔진 상태 코드: IDLE" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
